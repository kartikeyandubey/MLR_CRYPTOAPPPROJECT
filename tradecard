import React, { useMemo, useState } from "react";
import { useMutation, useQueryClient } from "@tanstack/react-query";
import { Loader2, ShieldCheck } from "lucide-react";
import { toast } from "sonner";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { executeTrade } from "@/lib/server-fns";
import { formatQty, formatUsd } from "@/lib/format";
import FeeBreakdown from "./FeeBreakdown";
import { cn } from "@/lib/utils";

const QUICK = [100, 500, 1000, 2500];

export default function TradeTicket({ asset, account }) {
  const [side, setSide] = useState("buy");
  const [amount, setAmount] = useState("500");
  const queryClient = useQueryClient();
  const mutation = useMutation({
    mutationFn: (payload) => executeTrade({ data: payload }),
    onSuccess: (result) => {
      if (!result.ok) {
        toast.error(result.error);
        return;
      }
      toast.success(
        `${result.order.side === "buy" ? "Bought" : "Sold"} ${formatQty(result.quantity)} ${result.order.symbol} · margin ${formatUsd(result.fee)}`
      );
      queryClient.invalidateQueries();
    },
    onError: () => toast.error("The order could not be placed. Please try again."),
  });

  const holding = account?.holdings?.find((h) => h.symbol === asset.symbol);
  const price = Number(asset.price) || 0;
  const notional = Math.max(0, Number(amount) || 0);
  const fee = Number((notional * 0.01).toFixed(2));
  const net = Number((notional - fee).toFixed(2));

  const available = useMemo(() => {
    if (side === "buy") return Number(account?.wallet?.balance_usd || 0);
    return Number(holding?.quantity || 0) * price;
  }, [side, account, holding, price]);

  const blocked = notional < 1 || notional > available;

  return (
    <div className="rounded-2xl border border-border/70 bg-card p-5 sm:p-6">
      <div className="grid grid-cols-2 gap-1 rounded-xl bg-secondary/70 p-1">
        {["buy", "sell"].map((option) => (
          <button
            key={option}
            type="button"
            onClick={() => setSide(option)}
            className={cn(
              "rounded-lg py-2.5 font-mono text-[0.68rem] uppercase tracking-[0.18em] transition-all",
              side === option
                ? option === "buy"
                  ? "bg-up/15 text-up"
                  : "bg-down/15 text-down"
                : "text-muted-foreground hover:text-foreground"
            )}
          >
            {option === "buy" ? "Buy" : "Sell"}
          </button>
        ))}
      </div>

      <div className="mt-5">
        <div className="flex items-baseline justify-between">
          <label htmlFor="order-amount" className="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-muted-foreground">
            Order value (USD)
          </label>
          <span className="font-mono text-[0.62rem] text-muted-foreground">
            Available {side === "buy" ? formatUsd(available) : `${formatQty(holding?.quantity || 0)} ${asset.symbol}`}
          </span>
        </div>
        <div className="mt-2 flex items-center gap-2 rounded-xl border border-border bg-background/60 px-3 py-1 focus-within:border-primary/60">
          <span className="font-mono text-sm text-muted-foreground">$</span>
          <Input
            id="order-amount"
            inputMode="decimal"
            value={amount}
            onChange={(event) => setAmount(event.target.value.replace(/[^0-9.]/g, ""))}
            className="h-11 border-0 bg-transparent px-0 font-mono text-lg focus-visible:ring-0"
          />
          <button
            type="button"
            onClick={() => setAmount(available > 0 ? String(Math.floor(available * 100) / 100) : "0")}
            className="rounded-md border border-border px-2 py-1 font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:border-primary hover:text-primary"
          >
            Max
          </button>
        </div>
        <div className="mt-2.5 flex flex-wrap gap-2">
          {QUICK.map((value) => (
            <button
              key={value}
              type="button"
              onClick={() => setAmount(String(value))}
              className={cn(
                "rounded-full border px-3 py-1 font-mono text-[0.62rem] transition-colors",
                Number(amount) === value
                  ? "border-primary text-primary"
                  : "border-border text-muted-foreground hover:text-foreground"
              )}
            >
              ${value}
            </button>
          ))}
        </div>
      </div>

      <div className="mt-5">
        <FeeBreakdown
          side={side}
          symbol={asset.symbol}
          price={price}
          notional={notional}
          fee={fee}
          net={net}
        />
      </div>

      <Button
        onClick={() => mutation.mutate({ symbol: asset.symbol, side, notional })}
        disabled={blocked || mutation.isPending}
        className={cn(
          "mt-5 h-12 w-full rounded-xl font-mono text-[0.7rem] uppercase tracking-[0.18em] text-primary-foreground",
          side === "buy" ? "bg-primary hover:bg-primary/90" : "bg-down text-white hover:bg-down/90"
        )}
      >
        {mutation.isPending ? (
          <Loader2 className="h-4 w-4 animate-spin" />
        ) : (
          `${side === "buy" ? "Buy" : "Sell"} ${asset.symbol}`
        )}
      </Button>

      {notional > available && (
        <p className="mt-3 text-center font-mono text-[0.62rem] text-down">
          {side === "buy" ? "Not enough USD balance." : `Not enough ${asset.symbol}.`}
        </p>
      )}

      <p className="mt-4 flex items-center justify-center gap-2 font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted-foreground">
        <ShieldCheck className="h-3 w-3" /> Fee quoted before execution
      </p>
    </div>
  );
}

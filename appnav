import React from "react";
import { Link, useNavigate } from "@tanstack/react-router";
import { LogOut } from "lucide-react";
import Brand from "@/components/Brand";
import { Button } from "@/components/ui/button";
import { useAuth } from "@/lib/AuthContext";
import { cn } from "@/lib/utils";

const NAV = [
  { label: "Terminal", to: "/trade" },
  { label: "Portfolio", to: "/portfolio" },
  { label: "Markets", to: "/markets" },
];

export default function AppNav() {
  const { user, logout } = useAuth();
  const navigate = useNavigate();
  const links = user?.role === "admin" ? [...NAV, { label: "Revenue", to: "/dashboard" }] : NAV;

  return (
    <header className="sticky top-0 z-40 border-b border-border/60 bg-background/85 backdrop-blur-xl">
      <div className="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-3.5 sm:px-8 lg:px-12">
        <Brand />

        <nav className="order-3 -mx-1 flex w-full items-center gap-1 overflow-x-auto md:order-2 md:mx-0 md:w-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {links.map((link) => (
            <Link
              key={link.to}
              to={link.to}
              activeProps={{ className: "bg-secondary text-foreground" }}
              className={cn(
                "whitespace-nowrap rounded-full px-3.5 py-2 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-foreground"
              )}
            >
              {link.label}
            </Link>
          ))}
        </nav>

        <div className="order-2 flex items-center gap-3 md:order-3">
          <span className="hidden max-w-[14ch] truncate font-mono text-[0.62rem] uppercase tracking-[0.14em] text-muted-foreground sm:block">
            {user?.full_name || user?.email}
          </span>
          <Button
            variant="outline"
            size="sm"
            className="rounded-full border-border px-3 font-mono text-[0.62rem] uppercase tracking-[0.14em]"
            onClick={async () => {
              await logout();
              navigate({ to: "/" });
            }}
          >
            <LogOut className="mr-1.5 h-3 w-3" /> Sign out
          </Button>
        </div>
      </div>
    </header>
  );
}

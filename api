import { createServerFn } from "@tanstack/react-start";
import { z } from "zod";
import { requireUser } from "@/lib/auth-middleware";

// The published platform margin: 1% of every transaction, both directions.
const FEE_RATE = 0.01;
const START_BALANCE = 25000;
const MIN_ORDER = 1;

const round = (value, digits) => Number(Number(value).toFixed(digits));

export const listAssets = createServerFn({ method: "GET" }).handler(async ({ context }) => {
  const page = await context
    .getBase44()
    .entities.MarketAsset.filter({}, { sort: "sort_order", limit: 50 });
  return page.items ?? [];
});

// Small random-walk so the tape moves like a live market.
export const tickPrices = createServerFn({ method: "POST" }).handler(async ({ context }) => {
  const base44 = context.getBase44();
  const page = await base44.entities.MarketAsset.filter({}, { sort: "sort_order", limit: 50 });
  const assets = page.items ?? [];
  if (!assets.length) return [];

  const updates = assets.map((asset) => {
    const drift = (Math.random() - 0.49) * 0.0055;
    const price = Math.max(0.000001, Number(asset.price) * (1 + drift));
    const change = Math.max(-18, Math.min(18, Number(asset.change_24h || 0) + drift * 100));
    return {
      id: asset.id,
      price: round(price, price >= 1 ? 2 : 6),
      change_24h: round(change, 2),
    };
  });

  await base44.asServiceRole.entities.MarketAsset.bulkUpdate(updates);
  return updates;
});

async function ensureWallet(base44, user) {
  const page = await base44.asServiceRole.entities.Wallet.filter(
    { user_email: user.email },
    { limit: 1 }
  );
  const existing = page.items?.[0];
  if (existing) return existing;
  return base44.asServiceRole.entities.Wallet.create({
    user_email: user.email,
    balance_usd: START_BALANCE,
    funded_usd: START_BALANCE,
  });
}

export const getAccount = createServerFn({ method: "GET" })
  .middleware([requireUser])
  .handler(async ({ context }) => {
    const base44 = context.getBase44();
    const wallet = await ensureWallet(base44, context.user);
    const page = await base44.entities.Holding.filter(
      { user_email: context.user.email },
      { sort: "-quantity", limit: 100 }
    );
    return { wallet, holdings: page.items ?? [], feeRate: FEE_RATE };
  });

export const listMyOrders = createServerFn({ method: "GET" })
  .middleware([requireUser])
  .handler(async ({ context }) => {
    const page = await context.getBase44().entities.TradeOrder.filter(
      { user_email: context.user.email },
      { sort: "-created_date", limit: 50 }
    );
    return page.items ?? [];
  });

const tradeInput = z.object({
  symbol: z.string().min(1).max(12),
  side: z.enum(["buy", "sell"]),
  notional: z.number().positive().max(1000000),
});

export const executeTrade = createServerFn({ method: "POST" })
  .middleware([requireUser])
  .validator(tradeInput)
  .handler(async ({ data, context }) => {
    const { user } = context;
    const base44 = context.getBase44();

    const assetPage = await base44.entities.MarketAsset.filter(
      { symbol: data.symbol },
      { limit: 1 }
    );
    const asset = assetPage.items?.[0];
    if (!asset) return { ok: false, error: "That market is not listed." };

    const price = Number(asset.price);
    if (!price || price <= 0) return { ok: false, error: "Price unavailable — try again." };

    const notional = round(data.notional, 2);
    if (notional < MIN_ORDER) return { ok: false, error: "Minimum order is $1.00." };

    const fee = round(notional * FEE_RATE, 2);
    const net = round(notional - fee, 2);
    if (net <= 0) return { ok: false, error: "Order too small after the platform margin." };

    const wallet = await ensureWallet(base44, user);
    const holdingPage = await base44.asServiceRole.entities.Holding.filter(
      { user_email: user.email, symbol: asset.symbol },
      { limit: 1 }
    );
    const holding = holdingPage.items?.[0] ?? null;

    let quantity;
    let nextBalance;
    let nextHolding;

    if (data.side === "buy") {
      if (Number(wallet.balance_usd) < notional) {
        return { ok: false, error: "Insufficient USD balance for this order." };
      }
      quantity = round(net / price, 8);
      if (quantity <= 0) return { ok: false, error: "Order too small." };

      nextBalance = round(Number(wallet.balance_usd) - notional, 2);
      const prevQty = Number(holding?.quantity || 0);
      const prevAvg = Number(holding?.avg_price || 0);
      const newQty = round(prevQty + quantity, 8);
      nextHolding = {
        quantity: newQty,
        avg_price: round((prevQty * prevAvg + notional) / newQty, 6),
      };
    } else {
      quantity = round(notional / price, 8);
      if (!holding || Number(holding.quantity) < quantity) {
        return { ok: false, error: `You don't hold enough ${asset.symbol} for this order.` };
      }
      nextBalance = round(Number(wallet.balance_usd) + net, 2);
      nextHolding = {
        quantity: round(Number(holding.quantity) - quantity, 8),
        avg_price: Number(holding.avg_price || price),
      };
    }

    await base44.asServiceRole.entities.Wallet.update(wallet.id, { balance_usd: nextBalance });

    if (holding) {
      await base44.asServiceRole.entities.Holding.update(holding.id, nextHolding);
    } else {
      await base44.asServiceRole.entities.Holding.create({
        user_email: user.email,
        symbol: asset.symbol,
        ...nextHolding,
      });
    }

    const order = await base44.asServiceRole.entities.TradeOrder.create({
      user_email: user.email,
      user_name: user.full_name || user.email,
      symbol: asset.symbol,
      asset_name: asset.name,
      side: data.side,
      price,
      quantity,
      notional,
      fee,
      net,
      fee_rate: FEE_RATE,
      status: "filled",
    });

    return { ok: true, order, balance_usd: nextBalance, fee, net, quantity, price };
  });

export const getRevenueStats = createServerFn({ method: "GET" })
  .middleware([requireUser])
  .handler(async ({ context }) => {
    if (context.user.role !== "admin") return { forbidden: true };

    const db = context.getBase44().asServiceRole;
    const [bySymbol, bySide, byTrader, recent, tradeCount, wallets] = await Promise.all([
      db.entities.TradeOrder.aggregate({ query: {}, groupBy: "symbol", sum: ["fee", "notional"] }),
      db.entities.TradeOrder.aggregate({ query: {}, groupBy: "side", sum: ["fee", "notional"] }),
      db.entities.TradeOrder.aggregate({ query: {}, groupBy: "user_email" }),
      db.entities.TradeOrder.list({ sort: "-created_date", limit: 10 }),
      db.entities.TradeOrder.count({}),
      db.entities.Wallet.aggregate({ query: {}, sum: ["balance_usd", "funded_usd"] }),
    ]);

    return {
      forbidden: false,
      feeRate: FEE_RATE,
      bySymbol: bySymbol.rows ?? [],
      bySide: bySide.rows ?? [],
      traderCount: (byTrader.rows ?? []).length,
      recent: recent.items ?? [],
      tradeCount,
      totals: wallets.rows?.[0] ?? { sum_balance_usd: 0, sum_funded_usd: 0 },
    };
  });

import React from "react";
import { formatUsd } from "@/lib/format";
import { cn } from "@/lib/utils";

export default function StatCard({ label, value, hint, tone = "default", icon: Icon }) {
  return (
    <div className="rounded-2xl border border-border/70 bg-card p-5">
      <div className="flex items-center justify-between gap-3">
        <p className="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-muted-foreground">{label}</p>
        {Icon && <Icon className="h-4 w-4 text-muted-foreground" strokeWidth={1.6} />}
      </div>
      <p
        className={cn(
          "mt-3 font-display text-2xl font-semibold tracking-tight tabular-nums sm:text-[1.7rem]",
          tone === "primary" ? "text-primary" : tone === "down" ? "text-down" : "text-foreground"
        )}
      >
        {typeof value === "number" ? formatUsd(value) : value}
      </p>
      {hint && <p className="mt-1.5 text-[0.78rem] leading-snug text-muted-foreground">{hint}</p>}
    </div>
  );
}
